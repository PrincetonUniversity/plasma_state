%!PS
%%BoundingBox: 36 72 576 756
% TEK2PS prolog file

% Font definitions (make 3/4 functions to avoid scaling if not needed)
/FntH /Courier findfont 80 scalefont def
/FntB /Courier findfont 160 scalefont def
/DFntL { /FntL /Courier findfont 73.4 scalefont def } def
/DFntM { /FntM /Courier findfont 50.2 scalefont def } def
/DFntS { /FntS /Courier findfont 44 scalefont def } def

% tektronix line styles
/NV { [] 0 setdash } def	% normal vectors
/DV { [8] 0 setdash } def	% dotted vectors
/DDV { [8 8 32 8] 0 setdash } def	% dot-dash vectors
/SDV { [32 8] 0 setdash } def	% short-dash vectors
/LDV { [64 8] 0 setdash } def	% long-dash vectors

% thin and thick lines
/DZ { 6.0 setlinewidth } def
/FZ { 3.0 setlinewidth } def

/PR	% char x y -> -  prints character
{	moveto show } def

/npp 0 def		% number of plots/page

/NP	% - -> - new page
% change default scale and orentation to match tek's
{	npp 0 gt {showpage} if
	/npp npp 1 add def
	1 setlinecap
	1 setlinejoin
	562 54 translate	% leave a border
	90 rotate
	.1666666 .1666666 scale	%0-4096X, 0-3120Y
	2.5 setlinewidth
	0 0 moveto
} def

/EP	% - -> end page
{	showpage} def

/DP	% tsizey -> - erase and home
{%	clippath 1 setgray fill 0 setgray
	0 exch moveto
} def

/m {moveto} def
/l {rlineto} def
/r {rmoveto} def
/s {stroke} def
/n {newpath} def
/v {newpath moveto {rlineto} repeat stroke} def
/vf {newpath moveto {rlineto} repeat gsave fill grestore stroke} def
FntH setfont
NP
FntH setfont
