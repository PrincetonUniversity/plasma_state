# Ranger plasma_state environment
# Source after:
#   scl enable gcc-toolset-13 bash

# ----------------------------------------------------------------------
# GCC toolset 13.3
# ----------------------------------------------------------------------

export GCC_ROOT=/opt/rh/gcc-toolset-13/root/usr
export PATH=${GCC_ROOT}/bin:${PATH}

export GCC_RUNTIME_ROOT=${GCC_ROOT}
export FLIBROOT=$(dirname "$(gcc -print-file-name=libgfortran.so)")

# GCC toolset libraries must stay before /usr/lib64.
export LD_LIBRARY_PATH=${GCC_ROOT}/lib64:${GCC_ROOT}/lib:${FLIBROOT}:${LD_LIBRARY_PATH}
export LIBRARY_PATH=${GCC_ROOT}/lib64:${GCC_ROOT}/lib:${FLIBROOT}:${LIBRARY_PATH}

export GCC10=1

export FC=gfortran
export CC=gcc
export CXX=g++

# ----------------------------------------------------------------------
# OpenMPI from Ranger RPMs
# ----------------------------------------------------------------------

export OPENMPI_HOME=/usr/lib64/openmpi
export PATH=${OPENMPI_HOME}/bin:${PATH}

export MPIF90=${OPENMPI_HOME}/bin/mpif90
export MPICC=${OPENMPI_HOME}/bin/mpicc
export MPICXX=${OPENMPI_HOME}/bin/mpicxx
export MPIFC=${OPENMPI_HOME}/bin/mpifort

export FORTRAN_COMMAND=${MPIF90}
export CC_COMMAND=${MPICC}
export CX_COMMAND=${MPICXX}
export MPI_CMD="${OPENMPI_HOME}/bin/mpiexec --bind-to none"

export F90HOME=${OPENMPI_HOME}

# ----------------------------------------------------------------------
# BLAS / LAPACK from Ranger RPMs
# ----------------------------------------------------------------------

export NETLIB_LAPACK_HOME=/usr

export L_BLAS=" -L${NETLIB_LAPACK_HOME}/lib64 -lblas"
export L_LAPACK=" -L${NETLIB_LAPACK_HOME}/lib64 -llapack"
export LMPI_SCALAPACK="${L_LAPACK}"

# ----------------------------------------------------------------------
# HDF5 / NetCDF from Ranger RPMs
# ----------------------------------------------------------------------

export HDF5_HOME=/usr
export NETCDF_C_HOME=/usr
export NETCDF_F_HOME=/usr
export NETCDF_FORTRAN_HOME=/usr
export NETCDF_MODDIR=/usr/lib64/gfortran/modules

export L_NETCDF=" \
-L${NETCDF_F_HOME}/lib64 -lnetcdff \
-L${NETCDF_C_HOME}/lib64 -lnetcdf \
-Wl,-rpath,${HDF5_HOME}/lib64 \
-L${HDF5_HOME}/lib64 \
-lhdf5_fortran \
-lhdf5hl_fortran \
-lhdf5_hl \
-lhdf5"

# ----------------------------------------------------------------------
# PSPLINE / EZCDF / UFILES
# Adjust paths to your installed Ranger builds.
# ----------------------------------------------------------------------

export PSPLINE_HOME=/u/mgorelen/transp_external/opt/pspline/2.0.1/gcc/13.3.0
export L_PSPLINE=" -L${PSPLINE_HOME}/lib -lpspline"

export EZCDF_HOME=/u/mgorelen/transp_external/opt/ezcdf/0.0.3/gcc/13.3.0
export L_EZCDF=" -L${EZCDF_HOME}/lib -lezcdf"

export UFILES_ROOT=/u/mgorelen/transp_external/opt/ufiles/0.5.0/gcc/13.3.0

export L_UFILES=" \
-L${UFILES_ROOT}/lib \
-luflib_userio \
-luflib \
-lr4smlib_userio \
-lr4smlib \
-lmds_sub \
-lufhdf \
-lmdstransp \
-linterp_sub \
-lextrac_sub \
-ltrgraf \
-lureadsub \
-ltokid \
-lufencod \
-lufport"

export L_MDSDUMMY=" \
-L${UFILES_ROOT}/lib \
-lmds_dummy \
-lmdstransp \
-lureadsub \
-lufencod \
-lufport"

export L_SGLIB=" -L${UFILES_ROOT}/lib -lsg -ljc -lufport"
export LD_LIBRARY_PATH=${UFILES_ROOT}/lib:${LD_LIBRARY_PATH}
export LIBRARY_PATH=${UFILES_ROOT}/lib:${LIBRARY_PATH}

# Ranger BLAS/LAPACK workaround
export L_LAPACK=""
export L_BLAS="/usr/lib64/libopenblas.so.0"

export L_SGDUMMY=" -L${UFILES_ROOT}/lib -lsgdummy"

export MDSPLUS_HOME=/usr/local/mdsplus
export MDSPLUS_ROOT=${MDSPLUS_HOME}
export MDSPLUS=${MDSPLUS_HOME}
export MDSPLUS_DIR=${MDSPLUS_HOME}_git

export MDSPLUS_INC=${MDSPLUS_DIR}/include

export L_MDSPLUS=" \
-Wl,-rpath,${MDSPLUS_HOME}/lib64 \
-Wl,-rpath-link,${MDSPLUS_HOME}/lib64 \
-L${MDSPLUS_HOME}/lib64 \
-lMdsLib"

# ----------------------------------------------------------------------
# Compiler trailers
# ----------------------------------------------------------------------

export FTN_MAIN=""

export FTN_TRAILER=" \
-Wl,-rpath,${FLIBROOT} \
-L${FLIBROOT} \
-lgfortran"

export CPP_TRAILER=" \
-Wl,-rpath,${FLIBROOT} \
-L${FLIBROOT} \
-lstdc++ \
-lgcc_s \
-lgcc"

export LOADER_TRAILER=" \
-L/usr/lib64 \
-lreadline \
-lhistory \
-ltermcap \
-ldl"

# ----------------------------------------------------------------------
# Runtime/build search paths
# Keep GCC toolset paths first.
# ----------------------------------------------------------------------

export LD_LIBRARY_PATH=\
${GCC_ROOT}/lib64:\
${GCC_ROOT}/lib:\
${FLIBROOT}:\
${OPENMPI_HOME}/lib:\
${HDF5_HOME}/lib64:\
${NETCDF_C_HOME}/lib64:\
${NETCDF_F_HOME}/lib64:\
