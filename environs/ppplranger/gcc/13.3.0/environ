export LIBRARY_PATH=\
${GCC_ROOT}/lib64:\
${GCC_ROOT}/lib:\
${FLIBROOT}:\
${OPENMPI_HOME}/lib:\
${HDF5_HOME}/lib64:\
${NETCDF_C_HOME}/lib64:\
${NETCDF_F_HOME}/lib64:\
${MDSPLUS_HOME}/lib64:\
${MDSPLUS_HOME}/lib:\
${PSPLINE_HOME}/lib:\
${EZCDF_HOME}/lib:\
${UFILES_ROOT}/lib:\
