export L_SUPERLU=" -L$SUPERLU_ROOT/lib64 -lsuperlu $L_BLAS"

export L_NNLIB=" -L$FANN_ROOT/lib -lfann"
export C_INCLUDE_PATH=$FANN_ROOT/include:$C_INCLUDE_PATH

export L_PSPLINE=" -L$PSPLINE_HOME/lib -lpspline"
export L_EZCDF=" -L$EZCDF_HOME/lib -lezcdf"

