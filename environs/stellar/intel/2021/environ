export L_MMM=" -L$MMM_ROOT/lib -lmmm"
export LMPI_MMM=" -L$MMM_ROOT/lib -lmmm"

export L_NEO=" -L$NEO_ROOT/lib -lneo -lgeo -lexpro -lmath -lumfpack -lbrainfuse"
export LMPI_NEO=" -L$NEO_ROOT/lib -lneo -lgeo -lexpro_mpi -lmath -lumfpack -lbrainfuse"

export L_CQL3D=" -L$CQL3D_ROOT/lib -lcql3d"
export LMPI_CQL3D=" -L$CQL3D_ROOT/lib -lmpi_cql3d"

export L_GENRAY=" -L$GENRAY_ROOT/lib -lgenray"
export LMPI_GENRAY=" -L$GENRAY_ROOT/lib -lgenray"

export L_TORAY_GA=" -L$TORAY_GA_ROOT/lib -ltoray_ga"
export LMPI_TORAY_GA=" -L$TORAY_GA_ROOT/lib -ltoray_ga"

export L_TORBEAM=" -L$TORBEAM_ROOT/lib -ltorbeam"
export LMPI_TORBEAM=" -L$TORBEAM_ROOT/lib -ltorbeam"

export L_LSCSQ=" -L$LSCSQ_ROOT/lib -llscsq -qopenmp"
export LMPI_LSCSQ=" -L$LSCSQ_ROOT/lib -llscsq -qopenmp"

export L_SGLIB=" -L$UFILES_ROOT/lib -lsg -ljc -lufport"
export L_SGDUMMY=" -L$UFILES_ROOT/lib -lsgdummy"

export L_UFILES=" -L$UFILES_ROOT/lib -luflib_userio -luflib -lr4smlib_userio -lr4smlib -lmds_sub -lufhdf -lmdstransp -linterp_sub -lextrac_sub -ltrgraf -lureadsub -ltokid -lufencod -lufport"
