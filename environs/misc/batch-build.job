#!/bin/bash

#SBATCH --partition=mccune
#SBATCH --job-name=transpbuild
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu=2GB
#SBATCH --time=4:00:00
#SBATCH -A transp

# This is a batch job script used for building TRANSP on a compute node.

date

pwd

echo "Compiler:" $_COMPILER $_COMPILER_VER
echo "Install location:" $LOCAL

export NTASKS=$SLURM_CPUS_PER_TASK
cd $TRANSPROOT/codesys/source
make --no-print-directory -f makefile.mk code_daemon

echo -e "\n\nDone"

date
