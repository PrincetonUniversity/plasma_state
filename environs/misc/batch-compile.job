#!/bin/bash

#SBATCH -p mccune
#SBATCH -n 4
#SBATCH -t 24:00:00
#SBATCH --mem=1GB
#SBATCH -A transp
#SBATCH -J cmpl-transp
#SBATCH -o compile.out
#SBATCH -e compile.err

# This is a batch job script used for building TRANSP on a compute node.

date

pwd

# Uncomment these lines if you are not building from scratch
#export BOOTSTRAP_NO_CLEANUP=1
#export GENMAKE_NO=1

echo "Compiler:" $COMPILER
echo "Build location:" $BUILD
echo "Install location:" $LOCAL

cd $TRANSPROOT

if [ -z $BOOTSTRAP_NO_CLEANUP ]; then
  echo -e "\n\nClobber previous build\n\n"
  cd $BUILD
  rm -rf libincl make marker
  cd $LOCAL
  rm -rf compsc config data debug dylib exe
  rm -rf isolver_data jnilib lib log mod mpi_mod
  rm -rf obj other preact qshare request result
  rm -rf shlib test-jnilib tmp uid work
fi

mkdir -p $LOGDIR

echo -e "\n\nConfigure\n\n"
csh -f $TRANSPROOT/bootstrap/install.csh

echo -e "\n\nMake begin\n\n"
${SC}/make_begin

if [ -z $GENMAKE_NO ]; then
  echo -e "\n\nRun genmake\n\n"
  ${SC}/genmake
fi

echo -e "\n\nRun code_daemon\n\n"
${SC}/code_daemon nomake nojava

echo -e "\n\nDone"
